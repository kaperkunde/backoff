{
  "name": "@kaperkunde/backoff",
  "version": "0.0.0",
  "description": "Per-place limits for outgoing calls: calls at once, spacing, calls a minute, time limits and byte budgets, a cool-down when a place refuses a call, a slowdown when it asks to be called more gently, and time limits learned from its answers. Composed from p-queue and cockatiel.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/backoff.git"
  },
  "keywords": [
    "rate-limit",
    "backoff",
    "throttle",
    "circuit-breaker",
    "retry-after",
    "concurrency",
    "adaptive"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "cockatiel": "^4.0.0",
    "p-queue": "^10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "tsdown": "0.23.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.2"
  }
}
